{
  "name": "@ward/api",
  "version": "0.1.0",
  "private": true,
  "description": "Ward Fastify HTTP API server.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx src/tokens/keygen.ts",
    "oidc-client-key": "tsx src/oidc/client-keygen.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.3",
    "@fastify/type-provider-zod": "1.0.3",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "jose": "6.2.10",
    "nodemailer": "10.2.1",
    "oidc-provider": "9.12.2",
    "openapi-types": "12.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/oidc-provider": "9.12.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
