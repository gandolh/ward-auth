    { "from": 530, "to": 700, "label": "The app's own session" },
    { "from": 720, "to": 930, "label": "Every request after" }
  ],
  "messages": [
    { "id": "visit", "from": "user", "to": "app", "y": 186, "label": "press Sign in with Ward", "variant": "default" },
    { "id": "authorize", "from": "app", "to": "user", "y": 222, "label": "302 → /ward-api/oidc/auth (PKCE)", "variant": "return" },
    { "id": "login-step", "from": "user", "to": "ward_api", "y": 260, "label": "authorize → login step /refresh/oidc/:uid", "variant": "default" },
    { "id": "to-login", "from": "ward_api", "to": "user", "y": 298, "label": "no live Ward session → /ward/login?oidc=", "variant": "return" },
    { "id": "load-login", "from": "user", "to": "ward_ui", "y": 336, "label": "Continue to Atrium", "variant": "default" },
    { "id": "post-login", "from": "ward_ui", "to": "ward_api", "y": 374, "label": "POST /login — identifier + password", "variant": "emphasis" },
    { "id": "verify", "from": "ward_api", "to": "ward_db", "y": 412, "label": "scrypt verify · write refresh family", "variant": "security" },
    { "id": "cookies", "from": "ward_api", "to": "ward_ui", "y": 450, "label": "Set-Cookie under /ward-api: access · refresh", "variant": "return" },
