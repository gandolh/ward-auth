  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Why a code flow",
      "items": [
        "Each app keeps its own accounts; Ward is a second way in",
        "Ward redirects only to an app's registered redirect URIs",
        "Apps prove who they are with a client assertion; Ward holds no app secret"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ward's cookies stay at Ward",
      "items": [
        "Access: 15-minute EdDSA JWT at /ward-api, for Ward's own pages",
        "Refresh: opaque 30-day row, rotated on use, at /ward-api/refresh",
        "The refresh family is the Ward session an app knows as ward_sid"
      ]
    },
    {
      "dot": "rose",
      "title": "The 30-second window",
      "items": [
        "Apps cache the /session-status answer for 30 seconds",
        "So a sign-out or revoke at Ward ends app sessions within 30 s",
        "Ward unreachable fails closed: the person uses the app's local password"
      ]
    }
  ]
}
