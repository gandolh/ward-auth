    ],
    "column_fit": "spread",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "handover",
        "label": "The handover",
        "focus": [
          "user",
          "app",
          "ward_ui",
          "ward_api"
        ],
        "note": "The app starts an OpenID Connect code flow; Ward's login step decides whether a password is needed."
      },
      {
        "id": "issuing",
        "label": "Issuing the session",
        "focus": [
          "ward_ui",
          "ward_api",
          "ward_db"
        ],
        "note": "One password check writes a refresh family; Ward's own cookies stay under /ward-api."
      },
      {
        "id": "checking",
        "label": "Checking the session",
        "focus": [
          "app",
          "ward_api",
          "ward_db"
        ],
        "note": "The app keeps its own session and asks Ward at most every 30 seconds whether ward_sid is still live."
      }
    ]
  },
  "participants": [
    { "id": "user", "type": "external", "label": "Person", "sublabel": "one browser" },
