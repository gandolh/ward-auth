    { "id": "app-cookie", "from": "app", "to": "user", "y": 682, "label": "the app's own session cookie", "variant": "return" },
    { "id": "revisit", "from": "user", "to": "app", "y": 756, "label": "GET /atrium — the app's cookie", "variant": "emphasis" },
    { "id": "status", "from": "app", "to": "ward_api", "y": 794, "label": "POST /session-status (≤ every 30 s)", "variant": "security" },
    { "id": "live", "from": "ward_api", "to": "ward_db", "y": 832, "label": "family live? account active? grant held?", "variant": "default" },
    { "id": "answer", "from": "ward_api", "to": "app", "y": 870, "label": "{ active, role } — cached 30 s", "variant": "return" },
    { "id": "page", "from": "app", "to": "user", "y": 908, "label": "200 — the page", "variant": "return" }
  ],
