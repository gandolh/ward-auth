    { "id": "ward_api", "type": "backend", "label": "Ward API", "sublabel": "/ward-api, OIDC provider" },
    { "id": "ward_db", "type": "database", "label": "SQLite", "sublabel": "accounts, sessions, grants" }
  ],
  "segments": [
