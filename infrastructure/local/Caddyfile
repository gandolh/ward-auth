# Ward's local gateway: the UI and the API on one origin, routed the way the
# VPS routes ward.<domain> (vps-deploy/infrastructure/Caddyfile): the API at
# /ward-api, the UI at the root. Local only.
#
# One origin is not a convenience here. The refresh cookie is scoped to
# /ward-api/refresh, and /refresh and /logout refuse any request whose Origin
# is not WARD_PUBLIC_ORIGIN, so the page and the API have to answer on the same
# scheme://host:port.

{
	auto_https off
	admin off
}

:80 {
	encode gzip zstd

	# The whole API. handle_path strips /ward-api, so Ward serves its own
	# root-level routes (/login, /refresh, /console/*, /.well-known/jwks.json).
	handle_path /ward-api/* {
		reverse_proxy ward-api:8791
	}

	# The UI's old address, before 2026-10-22: the same page at the root.
	redir /ward / 308
	handle_path /ward/* {
		redir {uri} 308
	}

	# "/" goes to the account page (a sign-in with no usable ?next= lands there
	# too). Not the SPA's own "/": its entry route always shows the sign-in
	# form, which after a successful sign-in reads as "my password did not
	# work".
	redir / /account 302

	# The UI: a static SPA at the root, so deep links fall back to index.html.
	handle {
		root * /srv/ward
		try_files {path} {path}/ /index.html
		file_server
	}
}
