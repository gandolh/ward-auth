{
  "name": "ward",
  "version": "0.1.0",
  "description": "Ward identity service — Fastify + SQLite auth for the estate.",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "ui",
    "docs",
    "shared-library"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace=api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:watch": "vitest",
    "keygen": "npm run keygen --workspace=api",
    "vendor": "npm run vendor --workspace=shared-library --",
    "house-style:sync": "node vendor/house-style/bin/sync.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "concurrently": "10.0.6",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.9.1",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "author": "",
  "license": "MIT",
  "overrides": {
    "@docusaurus/core": {
      "tinypool": "2.2.0"
    },
    "serialize-javascript": "7.1.3",
    "sockjs": {
      "uuid": "11.1.1"
    },
    "postcss-selector-parser": "7.1.7"
  }
}
